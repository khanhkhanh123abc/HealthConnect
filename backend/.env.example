# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# ─── Database (production) ──────────────────────────────────────────────────
# Preferred: single URL used by both runtime and sequelize-cli migrations.
# Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://avnadmin:CHANGE_ME@your-aiven-host.aivencloud.com:22255/defaultdb

# Optional fallback (used only if DATABASE_URL is unset; sequelize-cli will
# NOT pick these up — keep DATABASE_URL set for production migrations).
# DB_HOST=your-aiven-host.aivencloud.com
# DB_PORT=22255
# DB_USER=avnadmin
# DB_PASSWORD=CHANGE_ME
# DB_NAME=defaultdb
# DB_SSL=true

# ─── JWT ────────────────────────────────────────────────────────────────────
# REQUIRED. Use a random 32+ character string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ─── PayPal ─────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ─── URLs (used in PayPal redirect + email links) ───────────────────────────
BACKEND_URL=https://api.healthconnect.io.vn
FRONTEND_URL=https://healthconnect.io.vn

# ─── Mail (Nodemailer) ──────────────────────────────────────────────────────
EMAIL_APP=
EMAIL_APP_PASSWORD=

# ─── Bank transfer info (displayed in payment instructions) ─────────────────
BANK_NAME=MB Bank
BANK_ACCOUNT_NO=
BANK_OWNER=
